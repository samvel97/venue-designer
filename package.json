    "i18next": "^27.0.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "i18next-http-backend": "^4.0.10",
    "lucide-react": "^1.70.0",
    "pako": "^3.0.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-redux": "^9.3.1",
    "react-router": "^8.5.1",
    "react-zoom-pan-pinch": "^4.2.0",
